# WanderLust Environment Configuration

# Application Port (default: 8080)
PORT=8080

# MongoDB Connection String (leave blank for local MongoDB: mongodb://127.0.0.1:27017/wanderlust)
# For production (MongoDB Atlas):
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wanderlust?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust

# Session Secret (change in production)
SECRET=wanderlust_production_super_secret_key_12345

# Cloudinary (Optional - if not provided, images will be saved locally to public/uploads)
# CLOUD_NAME=your_cloudinary_cloud_name
# CLOUD_API_KEY=your_cloudinary_api_key
# CLOUD_API_SECRET=your_cloudinary_api_secret
