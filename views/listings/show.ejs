<% layout("/layouts/boilerplate.ejs") %>

<div class="show-page fade-in">

    <!-- Title & Subtitle -->
    <h1 class="show-title"><%= listing.title %></h1>
    <div class="show-subtitle">
        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <% let avgRating = (listing.reviews.reduce((s, r) => s + r.rating, 0) / listing.reviews.length).toFixed(1); %>
            <span class="rating-badge">
                <i class="fa-solid fa-star"></i>
                <%= avgRating %>
            </span>
            <span>&middot;</span>
            <span><%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %></span>
            <span>&middot;</span>
        <% } %>
        <span><%= listing.location %>, <%= listing.country %></span>
    </div>

    <!-- Main Image -->
    <div class="show-img-wrapper">
        <img
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1200' %>"
            class="show-img"
            alt="<%= listing.title %>"
        >
    </div>

    <!-- Content Grid: left info + right booking card -->
    <div class="show-content">

        <!-- LEFT COLUMN -->
        <div>

            <!-- Host Section -->
            <div class="host-section">
                <div class="host-info">
                    <div class="host-avatar">
                        <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : 'W' %>
                    </div>
                    <div>
                        <div class="host-name">Hosted by <%= listing.owner ? listing.owner.username : 'WanderLust Host' %></div>
                        <div class="host-since">WanderLust Host</div>
                    </div>
                </div>
                <div class="details-grid">
                    <div class="detail-item">
                        <i class="fa-solid fa-house"></i>
                        <span>Entire place</span>
                    </div>
                    <div class="detail-item">
                        <i class="fa-solid fa-wifi"></i>
                        <span>Wifi included</span>
                    </div>
                    <div class="detail-item">
                        <i class="fa-solid fa-location-dot"></i>
                        <span><%= listing.location %></span>
                    </div>
                    <div class="detail-item">
                        <i class="fa-solid fa-globe"></i>
                        <span><%= listing.country %></span>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="description-section">
                <h4 class="fw-600 mb-3">About this place</h4>
                <p><%= listing.description %></p>
            </div>

            <!-- Map -->
            <div class="map-section">
                <h4>Where you'll be</h4>
                <p class="text-muted-sm mb-3"><%= listing.location %>, <%= listing.country %></p>
                <div id="map"></div>
            </div>

            <!-- Reviews Section -->
            <div class="reviews-section">
                <div class="reviews-header">
                    <% if (listing.reviews && listing.reviews.length > 0) { %>
                        <% let avgRating = (listing.reviews.reduce((s, r) => s + r.rating, 0) / listing.reviews.length).toFixed(1); %>
                        <div class="overall-rating">
                            <i class="fa-solid fa-star"></i>
                            <%= avgRating %>
                        </div>
                        <span>&middot;</span>
                        <h4><%= listing.reviews.length %> Review<%= listing.reviews.length !== 1 ? 's' : '' %></h4>
                    <% } else { %>
                        <h4>No reviews yet</h4>
                    <% } %>
                </div>

                <!-- Reviews Grid -->
                <% if (listing.reviews && listing.reviews.length > 0) { %>
                <div class="reviews-grid">
                    <% for (let review of listing.reviews) { %>
                        <div class="review-card">
                            <div class="review-author">
                                <div class="review-avatar">
                                    <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                                </div>
                                <div>
                                    <div class="review-author-name">@<%= review.author ? review.author.username : 'User' %></div>
                                    <div class="review-date">
                                        <% let d = new Date(review.createdAt); %>
                                        <%= d.toLocaleDateString('en-IN', {month:'long', year:'numeric'}) %>
                                    </div>
                                </div>
                            </div>
                            <div class="review-stars">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <i class="fa-solid fa-star <%= i <= review.rating ? '' : 'empty' %>"></i>
                                <% } %>
                            </div>
                            <p class="review-comment"><%= review.comment %></p>
                            <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form class="review-delete-form" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn-danger-sm">Delete review</button>
                                </form>
                            <% } %>
                        </div>
                    <% } %>
                </div>
                <% } %>

                <!-- Add Review Form -->
                <% if (currUser) { %>
                <div class="add-review-section">
                    <h4>Share your experience</h4>
                    <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">

                        <div class="mb-3">
                            <label class="form-label">Your rating</label>
                            <fieldset class="starability-coinFlip">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating.">
                                <input type="radio" id="first-rate1" name="review[rating]" value="1">
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2">
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3">
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4">
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5">
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label">Your comment</label>
                            <textarea name="review[comment]" id="comment" rows="4" class="form-control" placeholder="Tell others about your stay..." required></textarea>
                            <div class="invalid-feedback">Please add a comment for your review!</div>
                        </div>

                        <button class="btn-airbnb" type="submit">Submit review</button>
                    </form>
                </div>
                <% } else { %>
                <div class="add-review-section">
                    <p class="text-muted-sm">
                        <a href="/login" style="color:var(--primary);font-weight:600;">Log in</a> to share your review.
                    </p>
                </div>
                <% } %>

            </div>

        </div>

        <!-- RIGHT COLUMN — Booking Card -->
        <div>
            <div class="booking-card">
                <div class="booking-card-price">
                    &#8377; <%= listing.price.toLocaleString("en-IN") %>
                    <span>/ night</span>
                </div>

                <% if (listing.reviews && listing.reviews.length > 0) { %>
                    <% let avg = (listing.reviews.reduce((s,r) => s + r.rating, 0) / listing.reviews.length).toFixed(1); %>
                    <div class="d-flex align-items-center gap-1 mb-3" style="font-size:0.9rem;">
                        <i class="fa-solid fa-star" style="color:var(--primary);font-size:0.85rem;"></i>
                        <strong><%= avg %></strong>
                        <span style="color:var(--text-medium);">&middot; <%= listing.reviews.length %> reviews</span>
                    </div>
                <% } %>

                <% if (currUser) { %>
                    <div class="booking-card-buttons">
                        <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                            <a href="/listings/<%= listing._id %>/edit" class="btn-airbnb">
                                <i class="fa-solid fa-pen fa-sm"></i> Edit listing
                            </a>
                            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                                <button class="btn-airbnb-outline w-100" type="submit">
                                    <i class="fa-solid fa-trash fa-sm"></i> Delete listing
                                </button>
                            </form>
                        <% } else { %>
                            <button class="btn-airbnb" onclick="alert('Booking feature coming soon! 🏡')">
                                Reserve
                            </button>
                            <p class="text-center text-muted-sm mt-2">You won't be charged yet</p>
                        <% } %>
                    </div>
                <% } else { %>
                    <a href="/login" class="btn-airbnb d-block text-center">Log in to book</a>
                <% } %>

                <hr class="divider">
                <div class="text-muted-sm">
                    <div class="d-flex justify-content-between mb-1">
                        <span>&#8377;<%= listing.price.toLocaleString("en-IN") %> &times; 5 nights</span>
                        <span>&#8377;<%= (listing.price * 5).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>WanderLust service fee</span>
                        <span>&#8377;<%= Math.round(listing.price * 5 * 0.12).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Taxes (18% GST)</span>
                        <span>&#8377;<%= Math.round(listing.price * 5 * 0.18).toLocaleString("en-IN") %></span>
                    </div>
                    <hr style="border-color:var(--border);">
                    <div class="d-flex justify-content-between fw-600" style="color:var(--text-dark);">
                        <span>Total</span>
                        <span>&#8377;<%= Math.round(listing.price * 5 * 1.3).toLocaleString("en-IN") %></span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Pass listing data to map.js -->
<script>
    const listingLocation = "<%= listing.location %>, <%= listing.country %>";
    const listingTitle = `<%= listing.title %>`;
</script>
<script src="/js/map.js"></script>