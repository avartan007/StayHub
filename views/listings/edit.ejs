<% layout("/layouts/boilerplate.ejs") %>

<div class="form-page fade-in">
    <h1 class="form-page-title">Edit your listing</h1>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

        <!-- Basic Info -->
        <div class="form-section">
            <div class="form-section-title">Basic Information</div>

            <div class="mb-4">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="listing[title]" id="title"
                    value="<%= listing.title %>"
                    class="form-control" required>
                <div class="invalid-feedback">Please enter a catchy title!</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" id="description" rows="4"
                    class="form-control" required><%= listing.description %></textarea>
                <div class="invalid-feedback">Please enter a description!</div>
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select name="listing[category]" id="category" class="form-select">
                    <% const categories = [
                        { val: "rooms", label: "Rooms" },
                        { val: "beach", label: "Beach" },
                        { val: "mountains", label: "Mountains" },
                        { val: "iconic", label: "Iconic Cities" },
                        { val: "castles", label: "Castles" },
                        { val: "pools", label: "Amazing Pools" },
                        { val: "camping", label: "Camping" },
                        { val: "farms", label: "Farms" },
                        { val: "arctic", label: "Arctic" },
                        { val: "island", label: "Islands" },
                        { val: "abroad", label: "Abroad" },
                        { val: "trending", label: "Trending" }
                    ]; %>
                    <% for (let cat of categories) { %>
                        <option value="<%= cat.val %>" <%= listing.category === cat.val ? 'selected' : '' %>>
                            <%= cat.label %>
                        </option>
                    <% } %>
                </select>
            </div>
        </div>

        <!-- Photo -->
        <div class="form-section">
            <div class="form-section-title">Update photo</div>

            <% if (listing.image && listing.image.url) { %>
                <p class="form-label mb-2">Current image</p>
                <div class="img-preview-wrapper mb-3">
                    <img src="<%= listing.image.url %>" class="img-preview" alt="Current listing image" style="display:block;">
                </div>
            <% } %>

            <label for="image" class="form-label">Upload new image <span class="text-muted-sm">(optional)</span></label>
            <input type="file" name="listing[image]" id="image" class="form-control" accept="image/*">

            <!-- New image preview -->
            <img id="new-img-preview" class="img-preview mt-2" style="display:none;" alt="New preview">
        </div>

        <!-- Price & Location -->
        <div class="form-section">
            <div class="form-section-title">Price & Location</div>

            <div class="mb-4">
                <label for="price" class="form-label">Price per night (&#8377;)</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-radius:12px 0 0 12px;border-color:var(--border);">&#8377;</span>
                    <input type="number" name="listing[price]" id="price"
                        value="<%= listing.price %>"
                        class="form-control"
                        style="border-radius:0 12px 12px 0 !important;"
                        min="0" required>
                </div>
                <div class="invalid-feedback">Please enter a valid price!</div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="location" class="form-label">City / Area</label>
                    <input type="text" name="listing[location]" id="location"
                        value="<%= listing.location %>"
                        class="form-control" required>
                    <div class="invalid-feedback">Please enter the location!</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" id="country"
                        value="<%= listing.country %>"
                        class="form-control" required>
                    <div class="invalid-feedback">Please enter the country!</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3 align-items-center">
            <button type="submit" class="btn-airbnb px-5">
                <i class="fa-solid fa-floppy-disk fa-sm"></i> Save changes
            </button>
            <a href="/listings/<%= listing._id %>" class="btn-airbnb-outline">Cancel</a>
        </div>

    </form>
</div>

<script>
    // Image preview for new upload
    document.getElementById("image").addEventListener("change", function() {
        const file = this.files[0];
        const preview = document.getElementById("new-img-preview");
        if (file) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = "block";
        } else {
            preview.style.display = "none";
        }
    });
</script>